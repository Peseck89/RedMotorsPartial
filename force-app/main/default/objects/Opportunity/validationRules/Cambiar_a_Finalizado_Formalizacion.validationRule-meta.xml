<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cambiar_a_Finalizado_Formalizacion</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  NOT(CONTAINS($Profile.Name, &quot;Admin&quot;)),
  ISPICKVAL(StageName, &quot;Finalizado&quot;),
  OR(
    $RecordType.DeveloperName = &quot;BMW&quot;,
    $RecordType.DeveloperName = &quot;MINI&quot;,
    $RecordType.DeveloperName = &quot;Omoda&quot;,
    $RecordType.DeveloperName = &quot;Jaecoo&quot;
  ),
  NOT(Envio_formalizacion_legal__c)
)</errorConditionFormula>
    <errorMessage>Para pasar a Finalizado, debe haberse enviado la formalización legal.</errorMessage>
</ValidationRule>
