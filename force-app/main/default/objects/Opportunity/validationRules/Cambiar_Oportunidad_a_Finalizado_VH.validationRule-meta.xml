<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cambiar_Oportunidad_a_Finalizado_VH</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  NOT(CONTAINS($Profile.Name, &quot;Admin&quot;)),
  ISPICKVAL(StageName, &quot;Finalizado&quot;),
  OR(
    $RecordType.DeveloperName = &quot;BMW&quot;,
    $RecordType.DeveloperName = &quot;MINI&quot;
  ),
  NOT(Tiene_Vehiculos_Reservados__c)
)</errorConditionFormula>
    <errorMessage>Para pasar a Finalizado, debe tener al menos un vehículo reservado.</errorMessage>
</ValidationRule>
