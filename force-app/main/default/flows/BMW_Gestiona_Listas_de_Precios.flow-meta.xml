            <name>pricebookId</name>
        </outputParameters>
    </actionCalls>
    <assignments>
        <name>Asigna_Empresa_Desde_Fallback</name>
        <label>Asigna Empresa Desde Fallback</label>
        <locationX>314</locationX>
        <locationY>92</locationY>
        <description>Fallback temporal: solo aplica cuando Opportunity.Empresa_Operadora__c está vacío.</description>
        <assignmentItems>
            <assignToReference>EmpresaIdResuelta</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>BMW_Compania_Fallback_Empresa.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Tiene_Empresa_Resuelta</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asigna_Empresa_Desde_Lookup</name>
        <label>Asigna Empresa Desde Lookup</label>
        <locationX>50</locationX>
        <locationY>92</locationY>
        <assignmentItems>
            <assignToReference>EmpresaIdResuelta</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>myVariable_current.Empresa_Operadora__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Tiene_Empresa_Resuelta</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Tiene_Empresa_Resuelta</name>
        <label>Tiene Empresa Resuelta</label>
        <locationX>176</locationX>
        <locationY>150</locationY>
        <description>Guarda de seguridad: solo invoca el resolver Apex cuando EmpresaIdResuelta quedó realmente poblado (evita pasar un Id vacío/'' al action call, tanto desde el lookup directo como desde el fallback sin coincidencia).</description>
        <defaultConnectorLabel>Sin Empresa resuelta (no se actualiza)</defaultConnectorLabel>
        <rules>
            <name>Empresa_Resuelta</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>EmpresaIdResuelta</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Resuelve_Pricebook_Empresa</targetReference>
            </connector>
            <label>Empresa Resuelta</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tiene_Empresa_Operadora</name>
        <label>Tiene Empresa Operadora</label>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <description>Empresa_Operadora__c es la fuente principal para resolver el Pricebook. BMW_Compania__c solo se usa como fallback temporal cuando el lookup está vacío (ver Asigna_Empresa_Desde_Fallback).</description>
        <defaultConnector>
            <targetReference>BMW_Compania_Fallback_Empresa</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sin Empresa Operadora (fallback)</defaultConnectorLabel>
        <rules>
            <name>Empresa_Operadora_Presente</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>myVariable_current.Empresa_Operadora__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asigna_Empresa_Desde_Lookup</targetReference>
            </connector>
            <label>Empresa Operadora Presente</label>
        </rules>
    </decisions>
    <decisions>
        <name>Pricebook_Resuelto_Exitosamente</name>
        <label>Pricebook Resuelto Exitosamente</label>
        <locationX>176</locationX>
        <locationY>308</locationY>
        <description>Solo se actualiza Opportunity.Pricebook2Id cuando el resolver devuelve EXITO. NO_CONFIGURADO/SELECCION_REQUERIDA/ERROR no sobrescriben el Pricebook actual (sin default silencioso).</description>
        <defaultConnectorLabel>Sin resolución (no se actualiza)</defaultConnectorLabel>
        <rules>
            <name>Resolucion_Exitosa</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PricebookResolutionStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>EXITO</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>PriceBookIdResuelto</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Actualiza_Pricebook_Opportunity</targetReference>
            </connector>
            <label>Resolución Exitosa</label>
        </rules>
    </decisions>
    <description>Gestiona la lista de precio de acuerdo a la Empresa y divisa de la Oportunidad, resolviendo el Pricebook dinámicamente (EmpresaPricebookResolver) en vez de Ids fijos por combinación.</description>
    <formulas>
        <name>CodigoErpLegacyDesdeCompania</name>
        <dataType>String</dataType>
        <description>Fallback temporal: traduce el picklist legacy BMW_Compania__c a Empresa.Codigo_ERP__c solo cuando Opportunity.Empresa_Operadora__c está vacío. No decide el Pricebook por nombre, solo ubica la Empresa.</description>
        <expression>CASE({!myVariable_current.BMW_Compania__c}, "Otobai", "RMOTOBAI", "Bavarian", "RMBAVARIAN", "")</expression>
    </formulas>
    <interviewLabel>BMW_Gestiona_Listas_de_Precios-2_InterviewLabel</interviewLabel>
    <label>Gestiona Listas de Precios</label>
    <processMetadataValues>
        <name>ObjectType</name>
