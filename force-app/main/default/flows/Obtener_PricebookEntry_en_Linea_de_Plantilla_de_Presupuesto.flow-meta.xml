    <decisions>
        <name>Tiene_Empresa_Operadora</name>
        <label>Tiene Empresa Operadora</label>
        <locationX>314</locationX>
        <locationY>359</locationY>
        <description>Empresa_Operadora__c (en la Plantilla de Presupuesto) es la fuente principal para resolver el Pricebook. BMW_Compania__c solo se usa como fallback temporal cuando el lookup está vacío.</description>
        <defaultConnector>
            <targetReference>BMW_Compania_Fallback_Empresa</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sin Empresa Operadora (fallback)</defaultConnectorLabel>
        <rules>
            <name>Empresa_Operadora_Presente</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Plantilla_de_Presupuesto__r.Empresa_Operadora__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asigna_Empresa_Desde_Lookup</targetReference>
            </connector>
            <label>Empresa Operadora Presente</label>
        </rules>
    </decisions>
    <decisions>
        <name>Pricebook_Resuelto_Exitosamente</name>
        <label>Pricebook Resuelto Exitosamente</label>
        <locationX>314</locationX>
        <locationY>683</locationY>
        <description>Solo continúa a buscar el PricebookEntry cuando el resolver devuelve EXITO. No continúa con Pricebook vacío ni elige arbitrariamente entre varias opciones.</description>
        <defaultConnectorLabel>Sin resolución (no se actualiza el precio)</defaultConnectorLabel>
        <rules>
            <name>Resolucion_Exitosa</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Resuelve_Pricebook_Empresa.status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>EXITO</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Obtener_Pricebook_Entry</targetReference>
            </connector>
            <label>Resolución Exitosa</label>
        </rules>
    </decisions>
